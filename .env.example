# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  Copie para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env no Git!
# ─────────────────────────────────────────────────────────────────────────────

# ── Pastas a incluir no backup (separadas por vírgula) ────────────────────────
BACKUP_FOLDERS=/home/usuario/documentos,/home/usuario/projetos,/etc/nginx

# ── Diretório local onde o .zip será salvo antes do upload ───────────────────
OUTPUT_DIR=backups

# ── Diretório onde os arquivos de log serão salvos ───────────────────────────
LOG_DIR=logs

# ── Google Drive ──────────────────────────────────────────────────────────────
# ID da pasta de destino no Drive (retirado da URL da pasta)
GDRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Caminho para o arquivo credentials.json baixado no Google Cloud Console
GDRIVE_CREDENTIALS_FILE=credentials.json

# Caminho onde o token OAuth será salvo automaticamente após a 1ª autenticação
GDRIVE_TOKEN_FILE=token.json

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_SESSION_TOKEN=                  # Opcional — deixe vazio se não usar STS
AWS_S3_BUCKET=meu-bucket-de-backups
AWS_REGION=us-east-1

# ── E-mail (SMTP) ─────────────────────────────────────────────────────────────
EMAIL_SENDER=backup@seudominio.com
EMAIL_RECIPIENT=admin@seudominio.com

# Gmail: smtp.gmail.com | Outlook: smtp.office365.com | SendGrid: smtp.sendgrid.net
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Para Gmail: use um App Password (não a senha da conta)
# https://myaccount.google.com/apppasswords
EMAIL_SMTP_PASSWORD=abcd efgh ijkl mnop
